# HTTP port inside the app process.
PORT=3000

# Host port used by docker-compose.example.yml.
CASHFLOW_HTTP_PORT=3000

# Image tag produced and selected by docker-compose.example.yml.
CASHFLOW_IMAGE_TAG=local

# Runtime data paths for direct Node/process-manager installs.
# Docker Compose overrides these inside the container.
DATA_DIR=./data
LOGS_DIR=./logs

# Database backend. SQLite is the default and recommended backend for
# standalone installs; it needs no other configuration. Postgres is available
# as an optional backend for multi-replica or externally-managed-database
# deployments; set CASHFLOW_DATABASE_URL when using it.
CASHFLOW_DB_BACKEND=sqlite
# CASHFLOW_DATABASE_URL=
# Guard for disposable Postgres integration tests. Leave off for normal use.
CASHFLOW_ENABLE_POSTGRES_TESTS=0

# Optional distributed runtime locks, needed for safely running multiple app
# replicas against a Postgres backend. Leave off for SQLite file storage.
CASHFLOW_RUNTIME_LOCK_BACKEND=none
# CASHFLOW_RUNTIME_LOCK_DATABASE_URL=
# CASHFLOW_RUNTIME_LOCK_OWNER_ID=

# Maximum JSON request body size for full import requests.
CASHFLOW_JSON_LIMIT=10mb

# Timezone used for server log timestamps.
# User planning timezone is configured in the app settings.
CASHFLOW_LOG_TIMEZONE=Europe/Warsaw

# Keep file logs enabled and also mirror log lines to stdout/stderr when wanted
# by a process manager or container log collector.
CASHFLOW_MIRROR_LOGS_TO_STDOUT=0

# Optional readiness expansion. The default /readyz check does not scan budgets.
CASHFLOW_READYZ_CHECK_DEFAULT_BUDGET=0

# Absolute paths allowed as custom per-profile backup locations.
# Compose defaults to /app/backups. Direct Node installs should use an absolute
# host path outside DATA_DIR.
# CASHFLOW_BACKUP_ALLOWED_ROOTS=/app/backups

# External provider request timeouts in milliseconds.
CASHFLOW_FX_FETCH_TIMEOUT_MS=10000
CASHFLOW_NOTIFICATION_FETCH_TIMEOUT_MS=5000

# Retention for completed recovery artifacts kept under DATA_DIR.
CASHFLOW_DELETED_BUDGET_RECOVERY_RETENTION_COUNT=5
CASHFLOW_GLOBAL_MIGRATION_RECOVERY_RETENTION_COUNT=2

# Optional internal-login password pepper.
# Treat as a deployment secret. Keep it stable; changing or losing it makes
# existing password hashes unverifiable.
# CASHFLOW_PASSWORD_PEPPER=

# Shared secret expected from a trusted reverse proxy in external SSO mode.
# The proxy sends this value in the configured assertion-secret header.
# CASHFLOW_EXTERNAL_AUTH_SECRET=

# Optional internal-mode provider client secrets. Configure the matching env
# variable name in Admin; the UI shows only whether the secret is present.
# CASHFLOW_GOOGLE_CLIENT_SECRET=
# CASHFLOW_GITHUB_CLIENT_SECRET=
# CASHFLOW_FACEBOOK_CLIENT_SECRET=

# Required only when running smoke commands against an existing deployment.
# Use a configured, non-local profile reserved for verification.
# CASHFLOW_BASE_URL=https://cashflow.example.com
# CASHFLOW_SMOKE_USER_ID=cashflow-smoke

# Browser smoke against a deployment is read-only unless explicitly enabled.
# CASHFLOW_ALLOW_MUTATING_SMOKE=0
