# HTTP port inside the app process.
PORT=3000

# Host port used by docker-compose.example.yml.
CASHFLOW_HTTP_PORT=3000

# Runtime data paths for direct Node/process-manager installs.
# Docker Compose overrides these inside the container.
DATA_DIR=./data
LOGS_DIR=./logs

# Timezone used for server log timestamps.
# User planning timezone is configured in the app settings.
CASHFLOW_LOG_TIMEZONE=Europe/Warsaw
